{
  "name": "@webmcp-contract/contract",
  "version": "0.2.0",
  "description": "WebMCP tool contract format, canonicalization, and risk classification",
  "keywords": [
    "webmcp",
    "mcp",
    "agents",
    "tool-contract",
    "json-schema",
    "canonicalization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pravoobi/webmcp-diff.git",
    "directory": "packages/contract"
  },
  "homepage": "https://github.com/pravoobi/webmcp-diff/tree/main/packages/contract#readme",
  "bugs": "https://github.com/pravoobi/webmcp-diff/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
