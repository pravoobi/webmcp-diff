{
  "name": "@webmcp-contract/extract",
  "version": "0.2.0",
  "description": "Playwright-based WebMCP tool-contract extractor",
  "keywords": [
    "webmcp",
    "mcp",
    "agents",
    "tool-contract",
    "playwright",
    "extractor",
    "polyfill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pravoobi/webmcp-diff.git",
    "directory": "packages/extract"
  },
  "homepage": "https://github.com/pravoobi/webmcp-diff/tree/main/packages/extract#readme",
  "bugs": "https://github.com/pravoobi/webmcp-diff/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "5.1.0",
    "@webmcp-contract/contract": "workspace:*",
    "playwright": "^1.49.1"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
