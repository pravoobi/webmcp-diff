{
  "name": "@webmcp-contract/diff",
  "version": "0.3.0",
  "description": "Structural + semantic diff engine and reporters for WebMCP contracts",
  "keywords": [
    "webmcp",
    "mcp",
    "agents",
    "tool-contract",
    "diff",
    "breaking-changes",
    "sarif"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pravoobi/webmcp-diff.git",
    "directory": "packages/diff"
  },
  "homepage": "https://github.com/pravoobi/webmcp-diff/tree/main/packages/diff#readme",
  "bugs": "https://github.com/pravoobi/webmcp-diff/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@webmcp-contract/contract": "workspace:*"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.123.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
