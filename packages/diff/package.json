{
  "name": "@webmcp-contract/diff",
  "version": "0.1.0",
  "description": "Structural + semantic diff engine and reporters for WebMCP contracts",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@webmcp-contract/contract": "workspace:*"
  },
  "files": ["dist"]
}
