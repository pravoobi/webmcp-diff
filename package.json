{
  "name": "webmcp-contract-diff",
  "version": "0.2.0",
  "private": true,
  "description": "Snapshot and diff the WebMCP tool contract a web app exposes to agents",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pravoobi/webmcp-diff.git"
  },
  "homepage": "https://github.com/pravoobi/webmcp-diff#readme",
  "bugs": "https://github.com/pravoobi/webmcp-diff/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "fixture": "node fixtures/shop/serve.mjs",
    "cli": "tsx packages/cli/src/bin.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "sync-license": "node scripts/sync-license.mjs",
    "prepublish-check": "pnpm lint && pnpm typecheck && pnpm test",
    "release": "pnpm sync-license && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "^3.0.1",
    "@webmcp-contract/cli": "workspace:*",
    "@webmcp-contract/contract": "workspace:*",
    "@webmcp-contract/diff": "workspace:*",
    "@webmcp-contract/extract": "workspace:*",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.13.0"
}
